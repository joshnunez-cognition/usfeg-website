# Copy to members/.env. Never commit real secrets.

# Site origin members will use. BluePay redirects the browser back here.
# Dev (Vite): http://localhost:5174
# Production example: https://members.usfeg.org
PUBLIC_URL=http://localhost:5174

PORT=3001
NODE_ENV=development

# Signs the session cookie. Use a long random string in production.
SESSION_SECRET=replace-with-a-long-random-string

# sqlite file and uploaded documents live here.
DATA_DIR=./data

# mock  — local simulator, no BluePay account required (default)
# TEST  — BluePay sandbox at secure.bluepay.com
# LIVE  — real charges
BLUEPAY_MODE=mock
BLUEPAY_ACCOUNT_ID=
BLUEPAY_SECRET_KEY=
# Must match the gateway account's "Hash Type in APIs".
# Official current PHP library default is HMAC_SHA512. Older accounts use MD5.
BLUEPAY_TPS_HASH_TYPE=HMAC_SHA512
# Seal on the hosted-form wrapper. The official PHP sample uses HMAC_SHA512.
BLUEPAY_SHPF_HASH_TYPE=HMAC_SHA512

# Optional SMTP. With these unset, messages are stored in the email_outbox table
# and printed to the server log (fine for local setup and invite testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="US FEG <rod@usfeg.org>"

# Bearer token for POST /api/cron/renewals (daily reminder job).
CRON_SECRET=replace-with-a-long-random-string

# Production only, and only when the database has no users yet.
# Ignored in development, which seeds a local demo admin instead.
# SEED_ADMIN_EMAIL=rod@usfeg.org
# SEED_ADMIN_PASSWORD=
