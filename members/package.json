{
  "name": "usfeg-members",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Member site for US Financial Executive Group. Separate from the public usfeg.org Vite app.",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "import": "tsx scripts/import-ym.ts",
    "renewals": "tsx scripts/send-renewals.ts",
    "create-admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "express": "^4.21.2",
    "nodemailer": "^7.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
